# Port cho Express server
PORT=3001

# Firebase Project ID
FIREBASE_PROJECT_ID=kdhelpmap

# Firebase Storage Bucket
FIREBASE_STORAGE_BUCKET=kdhelpmap.firebasestorage.app

# ===== CHỌN 1 TRONG 2 CÁCH ĐỂ XÁC THỰC FIREBASE ADMIN =====

# Cách 1: Đường dẫn file JSON (dùng cho local development)
# Tải file JSON từ Firebase Console → Project Settings → Service Accounts → Generate New Private Key
# GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey.json

# Cách 2: JSON string (dùng cho deploy trên Render, Railway, Vercel, etc.)
# Copy nội dung file JSON và paste dưới dạng 1 dòng string
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"kdhelpmap",...}
